# Rulenix Python Backend Production Environment Configuration Template
# Copy to .env.production and provide production values. Never commit real credentials.

APP_ENV=production
DATABASE_URL=postgresql+asyncpg://rulenix:CHANGE_ME@postgres:5432/rulenix
FRONTEND_ORIGIN=https://rulenix.in

# Sessions
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=24
OTP_HASH_KEY=replace-with-cryptographically-secure-otp-hash-key

# Credential Encryption (AES-GCM keys formatted as: 1:hex64key)
CREDENTIAL_ENCRYPTION_KEYS=1:replace-with-64-character-hex-encryption-key
CREDENTIAL_PRIMARY_VERSION=1

# Email / Alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Runtime & Authority
PYTHON_RUNTIME_MODE=authoritative
PYTHON_LIVE_TRADING_ENABLED=true
PYTHON_LIVE_AUTHORITY_LEASE_OWNER=e3c2385a-0000-4000-8000-000000000001
PYTHON_AUTHORITY_LEASE_SECONDS=30
PYTHON_WORKER_INTERVAL_SECONDS=5
AUTHORITATIVE_LIFECYCLE_CERTIFIED=true

# Angel One SmartAPI Base URLs
ANGEL_BASE_URL=https://apiconnect.angelone.in
ANGEL_WEBSOCKET_URL=wss://smartapisocket.angelone.in/smart-stream
