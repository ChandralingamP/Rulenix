[Unit]
Description=Rulenix Python migration runtime
After=network-online.target postgresql.service rulenix-egress-helper.service
Wants=network-online.target

[Service]
Type=simple
User=rulenix
Group=rulenix
WorkingDirectory=/opt/rulenix/python-backend
EnvironmentFile=/etc/rulenix/python-backend.env
ExecStart=/opt/rulenix/python-backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8081 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/rulenix-python

[Install]
WantedBy=multi-user.target
