map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream selected_rulenix_api {
    server ${RULENIX_API_UPSTREAM};
    keepalive 32;
}

server {
    listen 8080;
    server_tokens off;

    location /api/ {
        proxy_pass http://selected_rulenix_api/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /ws/ {
        proxy_pass http://selected_rulenix_api/api/ws/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location = /health {
        proxy_pass http://selected_rulenix_api/api/health/live;
    }

    location = /readiness {
        proxy_pass http://selected_rulenix_api/api/health/ready;
    }
}
