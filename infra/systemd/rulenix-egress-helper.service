[Unit]
Description=Restricted Rulenix Angel egress network helper
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=RULENIX_EGRESS_SOCKET=/run/rulenix-egress/helper.sock
Environment=RULENIX_EGRESS_INTERFACE=ens3
Environment=RULENIX_EGRESS_NETPLAN_FILE=/etc/netplan/60-rulenix-egress.yaml
Environment=RULENIX_EGRESS_STATE_FILE=/var/lib/rulenix-egress/managed-ipv4
Environment=RULENIX_EGRESS_SOCKET_UID=10001
Environment=RULENIX_EGRESS_VERIFY_URL=https://api.ipify.org
ExecStart=/usr/local/sbin/rulenix-egress-helper
Restart=on-failure
RestartSec=3
RuntimeDirectory=rulenix-egress
RuntimeDirectoryMode=0755
StateDirectory=rulenix-egress
StateDirectoryMode=0700
NoNewPrivileges=false
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_CHOWN
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/rulenix-egress /var/lib/rulenix-egress /etc/netplan /run/systemd/network

[Install]
WantedBy=multi-user.target
